# Normalize line endings: Git decides text vs binary automatically.
* text=auto

# --- Explicit text files (LF in repo) ---
*.md        text
*.txt       text
*.html      text
*.css       text
*.js        text eol=lf
*.ts        text eol=lf
*.json      text
*.yml       text
*.yaml      text
*.xml       text
*.sh        text eol=lf
*.py        text eol=lf
*.cs        text
Dockerfile  text
*.gitignore text
*.gitattributes text

# --- Windows scripts keep CRLF ---
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Mark binaries (no diff/merge, no EOL munging) ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.rar   binary
*.mp4   binary
*.mov   binary
*.mp3   binary
*.wav   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.psd   binary
*.sqlite binary
*.db    binary
*.bin   binary

# --- Optional: route very large binary types to Git LFS ---
# Requires `git lfs install` locally. Uncomment to enable.
# *.psd  filter=lfs diff=lfs merge=lfs -text
# *.zip  filter=lfs diff=lfs merge=lfs -text
# *.mp4  filter=lfs diff=lfs merge=lfs -text
# *.gguf filter=lfs diff=lfs merge=lfs -text
